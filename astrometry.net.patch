diff --git a/include/sys/resource.h b/include/sys/resource.h
new file mode 100644
index 00000000..16ed3e57
--- /dev/null
+++ b/include/sys/resource.h
@@ -0,0 +1,69 @@
+#ifndef ASTROMETRY_WINDOWS_SYS_RESOURCE_H
+#define ASTROMETRY_WINDOWS_SYS_RESOURCE_H
+
+#if !defined(_WIN32)
+#include_next <sys/resource.h>
+#else
+
+#include <stdint.h>
+#include <sys/time.h>
+#include <time.h>
+
+#define RUSAGE_SELF 0
+
+#define RLIMIT_NOFILE 7
+#define RLIMIT_DATA 2
+
+typedef uint64_t rlim_t;
+
+struct rlimit {
+    rlim_t rlim_cur;
+    rlim_t rlim_max;
+};
+
+struct rusage {
+    struct timeval ru_utime;
+    struct timeval ru_stime;
+    long ru_maxrss;
+};
+
+static __inline int getrusage(int who, struct rusage* usage) {
+    clock_t ticks;
+
+    if (!usage || who != RUSAGE_SELF)
+        return -1;
+
+    ticks = clock();
+    if (ticks == (clock_t)-1)
+        return -1;
+
+    usage->ru_maxrss = 0;
+    usage->ru_utime.tv_sec = (long)(ticks / CLOCKS_PER_SEC);
+    usage->ru_utime.tv_usec = (long)((ticks % CLOCKS_PER_SEC) * 1000000L / CLOCKS_PER_SEC);
+    usage->ru_stime.tv_sec = 0;
+    usage->ru_stime.tv_usec = 0;
+    return 0;
+}
+
+static __inline int getrlimit(int resource, struct rlimit* rlp) {
+    (void)resource;
+    if (!rlp)
+        return -1;
+    rlp->rlim_cur = (rlim_t)0x7fffffffffffffffULL;
+    rlp->rlim_max = (rlim_t)0x7fffffffffffffffULL;
+    return 0;
+}
+
+static __inline int setrlimit(int resource, const struct rlimit* rlp) {
+    (void)resource;
+    (void)rlp;
+    return 0;
+}
+
+static __inline int getpagesize(void) {
+    return 4096;
+}
+
+#endif
+
+#endif
