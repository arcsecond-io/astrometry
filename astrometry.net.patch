diff --git a/include/dirent.h b/include/dirent.h
new file mode 100644
index 00000000..01088765
--- /dev/null
+++ b/include/dirent.h
@@ -0,0 +1,90 @@
+#ifndef ASTROMETRY_WINDOWS_DIRENT_H
+#define ASTROMETRY_WINDOWS_DIRENT_H
+
+#if !defined(_WIN32)
+#include_next <dirent.h>
+#else
+
+#include <errno.h>
+#include <io.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef MAX_PATH
+#define MAX_PATH 260
+#endif
+
+struct dirent {
+    char d_name[MAX_PATH + 1];
+};
+
+typedef struct {
+    intptr_t handle;
+    struct _finddata_t data;
+    struct dirent ent;
+    char pattern[MAX_PATH + 4];
+    int first;
+} DIR;
+
+static __inline DIR* opendir(const char* path) {
+    size_t n;
+    DIR* dir;
+
+    if (!path) {
+        errno = EINVAL;
+        return NULL;
+    }
+
+    dir = (DIR*)calloc(1, sizeof(DIR));
+    if (!dir)
+        return NULL;
+
+    n = strlen(path);
+    if (n > (MAX_PATH - 3)) {
+        free(dir);
+        errno = ENAMETOOLONG;
+        return NULL;
+    }
+
+    strcpy(dir->pattern, path);
+    if (n && path[n - 1] != '\\' && path[n - 1] != '/')
+        strcat(dir->pattern, "\\");
+    strcat(dir->pattern, "*");
+
+    dir->handle = _findfirst(dir->pattern, &dir->data);
+    if (dir->handle == -1L) {
+        free(dir);
+        return NULL;
+    }
+    dir->first = 1;
+    return dir;
+}
+
+static __inline struct dirent* readdir(DIR* dir) {
+    if (!dir)
+        return NULL;
+
+    if (dir->first) {
+        dir->first = 0;
+    } else if (_findnext(dir->handle, &dir->data) != 0) {
+        return NULL;
+    }
+
+    strncpy(dir->ent.d_name, dir->data.name, MAX_PATH);
+    dir->ent.d_name[MAX_PATH] = '\0';
+    return &dir->ent;
+}
+
+static __inline int closedir(DIR* dir) {
+    if (!dir)
+        return -1;
+    if (dir->handle != -1L)
+        _findclose(dir->handle);
+    free(dir);
+    return 0;
+}
+
+#endif
+
+#endif
diff --git a/include/libgen.h b/include/libgen.h
new file mode 100644
index 00000000..96803fd1
--- /dev/null
+++ b/include/libgen.h
@@ -0,0 +1,47 @@
+#ifndef ASTROMETRY_WINDOWS_LIBGEN_H
+#define ASTROMETRY_WINDOWS_LIBGEN_H
+
+#if !defined(_WIN32)
+#include_next <libgen.h>
+#else
+
+#include <string.h>
+
+static __inline char* basename(char* path) {
+    char* p;
+    if (!path || !*path)
+        return path;
+    p = path + strlen(path);
+    while (p > path && (p[-1] == '/' || p[-1] == '\\'))
+        --p;
+    while (p > path && p[-1] != '/' && p[-1] != '\\')
+        --p;
+    return p;
+}
+
+static __inline char* dirname(char* path) {
+    static char dot[] = ".";
+    char* p;
+    if (!path || !*path)
+        return dot;
+    p = path + strlen(path);
+    while (p > path && (p[-1] == '/' || p[-1] == '\\'))
+        --p;
+    while (p > path && p[-1] != '/' && p[-1] != '\\')
+        --p;
+    if (p == path) {
+        if (*p == '/' || *p == '\\') {
+            p[1] = '\0';
+            return path;
+        }
+        return dot;
+    }
+    while (p > path && (p[-1] == '/' || p[-1] == '\\'))
+        --p;
+    *p = '\0';
+    return path;
+}
+
+#endif
+
+#endif
